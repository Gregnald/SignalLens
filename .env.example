# --- Database ---
POSTGRES_DB=signallens
POSTGRES_USER=signallens
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql+psycopg://signallens:change_me_locally@postgres:5432/signallens

# --- LLM provider ---
# One of: mock | gemini | groq
# "mock" runs with no external calls and clearly labels every LLM-origin field as mock output.
LLM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- ML models (do not change casually, see ARCHITECTURE.md) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# --- App ---
SECRET_KEY=change_me_locally
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Demo account (seeded by backend/app/seed.py) ---
# This is a local demo-only account with no real/financial data behind it.
DEMO_USER_EMAIL=demo@signallens.app
DEMO_USER_PASSWORD=SignalLens_Demo2026!
